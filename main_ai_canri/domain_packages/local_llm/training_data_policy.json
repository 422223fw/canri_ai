{
  "schema_version": 1,
  "name": "canri_native_v2_quality_policy",
  "description": "Use durable knowledge and validated examples while excluding mutable runtime state, duplicate indexes, benchmarks, and synthetic control graphs.",
  "include_globs": [
    "Knowledge_database.jsonl",
    "Articles.json",
    "*_scan_database.jsonl",
    "code.json",
    "Code_library_templates.json",
    "Code_project_recipes.json",
    "Code_terms_dictionary.json",
    "Library_functions.json",
    "Technical_terms.json",
    "Hardware_dictionary.json",
    "Company_products.json",
    "Technology_terms.json",
    "Geography_places.json",
    "Geography_concepts.json",
    "Geography_regions.json",
    "Geography_relations.json",
    "History_events.json",
    "History_figures.json",
    "History_timelines.json",
    "history_knowledge.json",
    "Math_formulas.json",
    "Math_examples.json",
    "Units_dictionary.json",
    "Translation_dictionary.json",
    "Synonyms.json",
    "Antonyms.json",
    "Abbreviations.json",
    "Idioms.json",
    "Slang_dictionary.json",
    "Emoji_dictionary.json",
    "Punctuation_dictionary.json",
    "Languages.json",
    "Conversation_patterns.json",
    "Emotional_support_strategies.json",
    "Story_genres.json",
    "Story_structures.json",
    "Character_traits.json",
    "Canri_self_profile.json",
    "Local_llm_instruction_seeds.json"
  ],
  "exclude_globs": [
    "*statistics*.json",
    "*_queue.json",
    "*_index.json",
    "*_index.sqlite*",
    "*chats*.json",
    "*memory*.json",
    "*_history.json",
    "Agent_audit.jsonl",
    "Agent_settings.local.json",
    "Local_model_settings.json",
    "Local_llm_generation_benchmark.json",
    "Release_*.json",
    "Improvement_queue.json",
    "Brain_performance.json",
    "*dependency_graph.json",
    "*evolution_graphs.json",
    "*scoring_rules.json",
    "*risk_rules.json"
  ]
}
